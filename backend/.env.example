# Copy this file to ".env" and fill in your key. NEVER commit .env to git.
# Get a free key in ~2 clicks at https://aistudio.google.com/app/apikey

GEMINI_API_KEY=paste-your-key-here

# Optional — defaults are fine to start:
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated frontend origins allowed to call this backend.
# For local dev with VS Code Live Server this is usually port 5500.
# Add your deployed frontend URL here once you host it (e.g. https://mitra-chat.netlify.app)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
